# Address the server listens on. 127.0.0.1 = this PC only; 0.0.0.0 = also the LAN and Tailscale.
REELNOTE_HOST=127.0.0.1
REELNOTE_PORT=3900
# Where reelnote.db, images, logs and backups live. Never inside the repo.
REELNOTE_DATA_DIR=E:\ReelnoteData
# Log level: fatal, error, warn, info, debug, trace
REELNOTE_LOG_LEVEL=info
# Extra origins accepted on writes, comma-separated, only if a proxy does not pass the browser's
# host on (e.g. https://<pc>.<tailnet>.ts.net). Usually empty.
REELNOTE_ALLOWED_ORIGINS=
# The Tailscale Serve address (https://<pc>.<tailnet>.ts.net), shown on People and access and in a new
# friend's sign-in hand-off. Optional.
REELNOTE_TAILSCALE_URL=
# Word lookup in transcripts (select a word, Look up) runs on Google Gemini. Keys are normally set in the
# app (account menu, Word lookup key: each person's own, and the owner's shared one); this is a fallback
# shared key, used when the app has none. Optional. Keep any key out of git.
REELNOTE_GEMINI_API_KEY=
# The Gemini model asked; optional.
REELNOTE_GEMINI_MODEL=gemini-3.5-flash-lite
